# JARVIS Environment Variables Template
# Copy this file to .env and fill in your actual values

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here  # Get from @BotFather on Telegram

# AI Services
GEMINI_API_KEY=your_gemini_api_key_here  # Get from Google AI Studio
# Alternative: GEMINI_API_KEYS=key1,key2,key3 for multiple keys

# Firebase / Firestore
FIREBASE_CREDENTIALS={"type": "service_account", "project_id": "your-project-id", ...}  # JSON string of your service account key

# Server Configuration
PORT=8080  # Port for local development (Vercel sets this automatically in production)

# Vercel Deployment
VERCEL_URL=jarvis-two-pi-13.vercel.app  # Your Vercel domain (without https://)

# Optional: Webhooks and External Services
# DISCORD_WEBHOOK_URL=your_discord_webhook_url  # If still using Discord for notifications

# NVIDIA NIM API Keys (Optional - Fallback for Gemini when rate-limited)
# Separate multiple keys with commas for automatic rotation
# NVIDIA_API_KEYS=nvapi-key1,nvapi-key2,nvapi-key3
# Optional: specify a different model (default: meta/llama-3.1-70b-instruct)
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
