{
    "version": 2,
    "functions": {
        "app/main.py": {
            "runtime": "@vercel/python"
        }
    },
    "rewrites": [
        {
            "source": "/",
            "destination": "app/main.py"
        },
        {
            "source": "/api/(.*)",
            "destination": "app/main.py"
        }
    ]
}